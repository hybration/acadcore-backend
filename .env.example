# Copy this file to .env and fill in real values. Never commit .env itself.

# Local Postgres example:
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/acadcore
# Supabase example:
# DATABASE_URL=postgresql://postgres:yourpassword@db.xxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=

# Same host/database as DATABASE_URL, but using the acadcore_super_admin
# role's credentials (created with BYPASSRLS back in the Phase 5 SQL setup)
# instead of acadcore_app's. Required for POST/GET /api/institutions to
# work — those endpoints are inherently cross-tenant (creating/listing
# institutions), so they need a connection that bypasses Row-Level Security
# entirely rather than being scoped to one institution_id.
# Example: postgresql://acadcore_super_admin:yourpassword@<same-host>:5432/postgres
SUPER_ADMIN_DATABASE_URL=

# Set to true when connecting to Supabase (or any host requiring SSL)
DB_SSL=false

# Long random string — used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long an access token stays valid
JWT_EXPIRES_IN=15m

PORT=4000
NODE_ENV=development

# The deployed frontend's URL (e.g. https://acadcore.vercel.app). Restricts
# which origins can call this API from a browser. Leave blank for local dev.
FRONTEND_URL=
